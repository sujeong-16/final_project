<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
     
<mapper namespace="react.boot.final_project.dao.AttMapper">
    <!-- 기본사항등록 - 근태 항목 등록 -->
	<!-- 근태 항목 리스트 -->
	<select id="regAttList" resultType="react.boot.final_project.dto.AttItemsDTO">
		SELECT * FROM attendance_view WHERE a_use = 'Y'
	</select>
    <!-- 근태 항목 등록 -->
    <insert id="insertAttItems" parameterType="react.boot.final_project.dto.AttItemsDTO">
        insert into attendance_tbl(a_code,a_name,a_type,a_note)
        values(#{a_code},#{a_name},#{a_type},#{a_note})
    </insert>
    <!-- 근태 항목 삭제 -->
    <delete id="deleteAttItems" parameterType="int">
        DELETE FROM attendance_tbl
         WHERE a_code = #{a_code}
    </delete>
    <!-- 근태 항목 수정 -->
    <update id="updateAttItems" parameterType="react.boot.final_project.dto.AttItemsDTO">
        UPDATE attendance_tbl
			   SET a_name = #{a_name}
			     , a_type = #{a_type}
			     , a_use = #{a_use}
			     , a_note = #{a_note}
			 WHERE a_code = #{a_code}
    </update>
    
	<!-- 기본사항등록 - 휴가 항목 등록 -->
	<select id="regVacaList" parameterType="String" resultType="react.boot.final_project.dto.VacaItemsDTO">
		SELECT *
		  FROM (SELECT *
		  			 , ROW_NUMBER() OVER (ORDER BY v_code DESC) AS rn
		    	  FROM vacation_tbl
				) AS subquery
		 where v_use = 'Y'
		 ORDER BY rn DESC
	</select>
	
	<!-- 기본사항등록 - 근태 항목 등록; 검색 -->
	<select id="attSearch" parameterType="String" resultType="react.boot.final_project.dto.AttItemsDTO">
		SELECT * FROM attendance_tbl 
		WHERE a_keywords LIKE '%' || '#{a_keywords}' || '%'
		   and a_use = 'Y'
	</select>
	
    
